---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { themeCss } from '../lib/themes';
import { site } from '../site.config';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  /** Absolute or root-relative image for social cards. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Structured data objects, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  keywords,
  image = '/og-default.png',
  imageAlt = `${site.name} — save Gmail™ attachments to Google Drive™ automatically`,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site);
const imageUrl = new URL(image, Astro.site);
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const { umamiWebsiteId, gaMeasurementId } = site.analytics;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline set:html={themeCss(site.defaultTheme)}></style>
    <script is:inline src="/js/theme.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <slot name="head" />

    {
      import.meta.env.PROD && (
        <>
          <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umamiWebsiteId} />
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
          <script is:inline src="/js/analytics.js" />
        </>
      )
    }

    {ldBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {site.themeSwitcher && <ThemeSwitcher />}
  </body>
</html>
