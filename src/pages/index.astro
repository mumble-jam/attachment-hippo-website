---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import Illo from '../components/Illo.astro';
import Marquee from '../components/Marquee.astro';
import Stamp from '../components/Stamp.astro';
import { site } from '../site.config';

const useCases = [
  {
    icon: 'uc-invoice',
    tint: 'mint',
    who: 'Small businesses & freelancers',
    title: 'Automated invoice and report archiving',
    text: 'Automatically save invoices and financial reports from Gmail™ to Google Drive™. Perfect for small businesses and freelancers who need organized, accessible records for billing, audits, or tax prep.',
  },
  {
    icon: 'uc-contract',
    tint: 'lilac',
    who: 'Lawyers & legal teams',
    title: 'Contract management',
    text: 'Simplify contract management by auto-saving signed agreements and legal documents from Gmail™ to Google Drive™. Ideal for lawyers, contractors, and legal teams.',
  },
  {
    icon: 'uc-team',
    tint: 'butter',
    who: 'Teams',
    title: 'Team collaboration',
    text: 'Keep teams aligned by automatically storing email attachments — like docs and presentations — in shared Google Drive™ folders. Ensure everyone works from the latest version.',
  },
  {
    icon: 'uc-photo',
    tint: 'sky',
    who: 'Product & event photos',
    title: 'Automatic photo backup',
    text: 'Auto-save images from Gmail™ to Google Drive™. Great for backing up product shots, event photos, or visual assets without manual downloads.',
  },
  {
    icon: 'uc-education',
    tint: 'lilac',
    who: 'Students & teachers',
    title: 'Organization of educational resources',
    text: 'Automatically store class materials, notes, and research papers from Gmail™ to Google Drive™. Built for students, teachers, and academic professionals who need quick access and structure.',
  },
];

const plans = [
  { icon: 'plan-beginner', name: 'Beginner', price: 'Free', note: '', points: ['Up to 2 automation rules', 'Up to 10 attachments per month', 'Daily processing'] },
  { icon: 'plan-essential', name: 'Essential', price: '$1.99', note: '/mo, billed annually', points: ['Up to 5 automation rules', 'Up to 100 attachments per month', 'Processing every 3 hours'] },
  { icon: 'plan-pro', name: 'Pro', price: '$4.99', note: '/mo, billed annually', points: ['Up to 10 automation rules', 'Up to 3000 attachments per month', 'Processing every 1 hour'] },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: site.name,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, Google Workspace',
    description: 'Automatically download and save your Gmail attachments to Google Drive.',
    url: site.url,
    installUrl: site.installUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.url, email: site.email },
];
---

<Base
  title="Download and save Gmail™ attachments to Google Drive™ automatically"
  description="Automatically download and save your Gmail attachments to Google Drive"
  keywords="Gmail, Google Drive, attachments, automation, email"
  jsonLd={jsonLd}
>
  <!-- ============ HERO ============ -->
  <section class="sheet sheet--mint hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title" class="display hero-title">
        Save Gmail<span class="tm">™</span> attachments to Drive<span class="tm">™</span> automatically
      </h1>
      <p class="lead hero-sub">
        Save your time and be sure that your attachments from Gmail™ are saved automatically in the Drive™ folder.
      </p>

      <div class="hero-line">
        <span class="mono hero-tag">Gmail™ add-on</span>
        <Stamp href={site.installUrl} external label="Add to<br>Gmail™" ring="It’s free · It’s free · It’s free ·" />
        <span class="mono hero-tag hero-tag--end">Free to start</span>
      </div>

      <div class="hero-scene" data-reveal>
        <HeroScene />
      </div>
    </div>
  </section>

  <Marquee items={['Invoices', 'Reports', 'Contracts', 'Presentations', 'Photos', 'Class notes', 'Research papers']} />

  <!-- ============ USE CASES ============ -->
  <section id="use-cases" class="sheet" aria-labelledby="use-cases-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="use-cases-title" class="h2">Use cases</h2>
        <span class="side">01—05</span>
      </div>

      <ol class="cases" role="list">
        {
          useCases.map((uc, i) => (
            <li class="case" data-reveal>
              <div class={`case-art sheet--${uc.tint}`}>
                <Illo name={uc.icon} class="case-illo" />
              </div>
              <div class="meta-row mono">
                <span>Use case {String(i + 1).padStart(2, '0')}</span>
                <span>{uc.who}</span>
              </div>
              <h3 class="h3 case-title">{uc.title}</h3>
              <p class="case-text">{uc.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ PRICING PREVIEW ============ -->
  <section class="sheet sheet--butter" aria-labelledby="plans-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="plans-title" class="h2">Pricing</h2>
        <span class="side">Grows with you</span>
      </div>

      <ul class="plans" role="list">
        {
          plans.map((p) => (
            <li class="plan" data-reveal>
              <div class="plan-main">
                <Illo name={p.icon} class="plan-illo" />
                <div>
                  <h3 class="plan-name">{p.name}</h3>
                  <p class="plan-price">
                    <span class="num">{p.price}</span>
                    {p.note && <span class="muted">{p.note}</span>}
                  </p>
                </div>
              </div>
              <ul class="plan-points" role="list">
                {p.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      <div class="plans-foot">
        <a class="btn btn--ink btn--lg" href="/pricing.html">See all plans <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="sheet sheet--lilac" aria-labelledby="contact-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="contact-title" class="h2">Contact us</h2>
        <span class="side">Say hi</span>
      </div>

      <div class="contact">
        <Illo name="part-envelope" class="contact-illo" />
        <div>
          <p class="lead contact-text">We’d love to hear from you! Drop us a line and we’ll get back to you as soon as possible.</p>
          <a class="contact-mail" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding-top: clamp(3.5rem, 2rem + 6vw, 8rem);
    padding-bottom: clamp(2rem, 1rem + 3vw, 4rem);
    text-align: center;
  }
  .hero-title {
    max-width: 24ch;
    margin-inline: auto;
    font-size: clamp(3.25rem, 1rem + 7vw, 7.5rem);
  }
  .hero-sub {
    max-width: 30rem;
    margin: 1.75rem auto 0;
  }
  .hero-line {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .hero-line::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--line-strong);
  }
  .hero-line > :global(*) {
    position: relative;
  }
  .hero-tag {
    justify-self: start;
    transform: translateY(-1.4rem);
  }
  .hero-tag--end {
    justify-self: end;
  }
  .hero-scene {
    max-width: 68rem;
    margin: clamp(1.5rem, 1rem + 2vw, 3rem) auto 0;
    text-align: left;
  }

  /* ---------- use cases ---------- */
  .cases {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 2rem + 3vw, 5rem) var(--gutter);
  }
  .case:nth-child(even) {
    margin-top: clamp(0rem, -2rem + 10vw, 8rem);
  }
  .case-art {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-card);
    margin-bottom: 1.25rem;
    overflow: hidden;
  }
  .case-art :global(.case-illo) {
    width: 46%;
    transition: transform 600ms var(--ease);
  }
  .case:hover .case-art :global(.case-illo) {
    transform: scale(1.08) rotate(-2deg);
  }
  .case-title {
    margin-top: 0.875rem;
    max-width: 16ch;
  }
  .case-text {
    margin-top: 0.875rem;
    max-width: 40ch;
    color: var(--ink-2);
  }

  /* ---------- plans ---------- */
  .plans {
    border-bottom: 1px solid var(--line);
  }
  .plan {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem var(--gutter);
    align-items: center;
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    border-top: 1px solid var(--line);
  }
  .plan-main {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .plan-main :global(.plan-illo) {
    width: clamp(5.5rem, 4rem + 5vw, 9rem);
    flex: none;
  }
  .plan-name {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 2rem + 5vw, 7rem);
    font-weight: 500;
    line-height: 0.9;
  }
  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.875rem;
    font-size: var(--fs-s);
  }
  .plan-price .num {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1;
  }
  .plan-points li {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
    padding-block: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .plan-points li:first-child {
    border-top: 0;
  }
  .plans-foot {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  /* ---------- contact ---------- */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem var(--gutter);
    align-items: center;
  }
  .contact :global(.contact-illo) {
    width: min(100%, 18rem);
  }
  .contact-text {
    max-width: 30ch;
  }
  .contact-mail {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 0.6rem + 4vw, 4.25rem);
    font-weight: 500;
    line-height: 1.05;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(var(--peach), var(--peach)) 0 100% / 100% 0.14em no-repeat;
    transition: background-size 300ms var(--ease);
  }
  .contact-mail:hover {
    background-size: 100% 100%;
  }

  @media (max-width: 760px) {
    .hero-tag {
      display: none;
    }
    .hero-line {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .cases {
      grid-template-columns: minmax(0, 1fr);
    }
    .case:nth-child(even) {
      margin-top: 0;
    }
    .plan {
      grid-template-columns: minmax(0, 1fr);
    }
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
    .contact :global(.contact-illo) {
      width: 10rem;
    }
  }
</style>
