---
import Base from '../layouts/Base.astro';
import Illo from '../components/Illo.astro';
import { site } from '../site.config';

const check = 'M3 8.5l3.2 3L13 4.5';
---

<Base
  title="Pricing — Attachment Hippo"
  description="Attachment Hippo Pricing - Choose the perfect plan for your needs"
  keywords="Gmail, Google Drive, attachments, automation, pricing"
>
  <Fragment slot="head">
    <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
    <script is:inline src="/js/pricing.js"></script>
  </Fragment>

  <section class="sheet sheet--lilac sheet--tight intro" aria-labelledby="pricing-title">
    <div class="wrap intro-grid">
      <h1 id="pricing-title" class="h2 intro-title">Pricing</h1>
      <p class="lead intro-text">Start free. Upgrade when your inbox does.</p>
    </div>
  </section>

  <section class="sheet sheet--grey plans-sheet" aria-label="Plans">
    <div class="wrap">
      <div class="plans">
        <!-- Beginner -->
        <article class="plan" aria-labelledby="plan-beginner" data-reveal>
          <div class="plan-art sheet--mint"><Illo name="plan-beginner" class="plan-illo" /></div>
          <div class="meta-row mono"><span>Plan 01</span><span>Forever</span></div>
          <h2 id="plan-beginner" class="plan-name">Beginner</h2>
          <p class="plan-price"><span class="price-amount">Free</span></p>
          <div class="plan-note"></div>
          <a class="btn btn--white btn--lg btn--block" href={site.installUrl} target="_blank" rel="noopener noreferrer">
            Get started <span class="arrow" aria-hidden="true">→</span>
          </a>
          <ul class="features" role="list">
            {
              [
                'Google Drive integration',
                'Automatic attachment saving',
                'Up to 2 automation rules',
                'Up to 10 attachments per month',
                'Custom file name',
                'Daily processing',
                'Email support',
              ].map((f) => (
                <li>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d={check} /></svg>
                  <span>{f}</span>
                </li>
              ))
            }
          </ul>
        </article>

        <!-- Essential -->
        <article class="plan" aria-labelledby="plan-essential" data-reveal>
          <div class="plan-art sheet--sky"><Illo name="plan-essential" class="plan-illo" /></div>
          <div class="meta-row mono"><span>Plan 02</span><span>Annual only</span></div>
          <h2 id="plan-essential" class="plan-name">Essential</h2>
          <p class="plan-price">
            <span class="price-amount">$23.88</span> <span class="price-period">($1.99/mo)</span>
          </p>
          <div class="plan-note"></div>
          <button
            id="essential-checkout-button"
            type="button"
            class="btn btn--white btn--lg btn--block paddle_button cta-button"
            data-items='[{"priceId":"pri_01jjevdqjqnxdyt62xxh64ztfm","quantity":1}]'
          >
            Get started <span class="arrow" aria-hidden="true">→</span>
          </button>
          <ul class="features" role="list">
            <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d={check} /></svg><span>Up to <strong>5</strong> automation rules</span></li>
            <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d={check} /></svg><span>Up to <strong>100</strong> attachments per month</span></li>
            <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d={check} /></svg><span>Processing every <strong>3 hours</strong></span></li>
          </ul>
        </article>

        <!-- Pro -->
        <article class="plan plan--featured" aria-labelledby="plan-pro" data-reveal>
          <div class="plan-art sheet--butter">
            <Illo name="plan-pro" class="plan-illo" />
            <span class="badge">Most popular</span>
          </div>
          <div class="meta-row mono"><span>Plan 03</span><span>Annual or monthly</span></div>
          <h2 id="plan-pro" class="plan-name">Pro</h2>
          <p class="plan-price" id="pro-price" aria-live="polite">
            <span class="price-amount">$59.88</span> <span class="price-period">($4.99/mo)</span>
          </p>
          <div class="plan-note">
            <fieldset class="billing">
              <legend class="visually-hidden">Billing period</legend>
              <label><input type="radio" name="pro-billing" value="annual" checked /><span>Annual (Save 55%)</span></label>
              <label><input type="radio" name="pro-billing" value="monthly" /><span>Monthly</span></label>
            </fieldset>
          </div>
          <button
            id="pro-checkout-button"
            type="button"
            class="btn btn--lg btn--block paddle_button cta-button"
            data-items='[{"priceId":"pri_01kjfswp1vfxyb9z44rdygmj7e","quantity":1}]'
          >
            Get started <span class="arrow" aria-hidden="true">→</span>
          </button>
          <ul class="features" role="list">
            <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d={check} /></svg><span>Up to <strong>10</strong> automation rules</span></li>
            <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d={check} /></svg><span>Up to <strong>3000</strong> attachments per month</span></li>
            <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d={check} /></svg><span>Processing every <strong>1 hour</strong></span></li>
          </ul>
        </article>
      </div>

      <!-- Custom -->
      <div class="custom" data-reveal>
        <div class="custom-art"><Illo name="plan-custom" class="plan-illo" /></div>
        <div class="custom-body">
          <div class="meta-row mono"><span>Plan 04</span><span>Teams</span></div>
          <h2 class="plan-name">Custom</h2>
          <p class="lead">For teams that need custom limits, domain-wide licensing, retrospective downloads.</p>
        </div>
        <a class="btn btn--ink btn--lg custom-btn" href="/#contact">Contact us <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .intro-title {
    font-size: clamp(5rem, 2rem + 12vw, 13rem);
    line-height: 0.85;
  }
  .intro-text {
    max-width: 20ch;
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
    font-family: var(--font-display);
    line-height: 1.05;
  }

  .plans-sheet {
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    align-items: start;
  }
  .plan {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0.75rem 1.75rem;
    background: var(--paper);
    border-radius: calc(var(--r-card) + 0.5rem);
  }
  .plan > :not(.plan-art) {
    margin-inline: 0.75rem;
  }
  .plan-art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: var(--r-card);
    margin-bottom: 1.25rem;
  }
  .plan-art :global(.plan-illo) {
    width: 42%;
  }
  .badge {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--peach);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .plan-name {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 2.6vw, 4.5rem);
    font-weight: 500;
    line-height: 0.9;
  }
  .plan-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    margin-top: 1rem;
  }
  .plan-price :global(.price-amount) {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 1.2vw, 3rem);
    font-weight: 500;
    line-height: 1;
  }
  .plan-price :global(.price-period) {
    color: var(--ink-3);
    font-size: var(--fs-s);
  }
  .plan-note {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
  }
  .plan .btn--block {
    width: auto;
  }
  .plan .btn--white {
    background: var(--grey);
  }
  .plan .btn--white:hover {
    background: var(--ink);
  }

  .billing {
    display: inline-flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0.25rem;
    border: 0;
    border-radius: 999px;
    background: var(--grey);
  }
  .billing label {
    position: relative;
    cursor: pointer;
  }
  .billing input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .billing span {
    display: block;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    transition: background-color 200ms var(--ease), color 200ms var(--ease);
  }
  .billing input:checked + span {
    background: var(--ink);
    color: var(--paper);
  }
  .billing input:focus-visible + span {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .features {
    margin-top: 1.5rem;
  }
  .features li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.625rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-s);
  }
  .features strong {
    font-weight: 800;
  }
  .features svg {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    transform: translateY(0.1em);
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .custom {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.5rem clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: center;
    margin-top: var(--gutter);
    padding: 0.75rem clamp(1.25rem, 1rem + 1vw, 2rem) 0.75rem 0.75rem;
    background: var(--paper);
    border-radius: calc(var(--r-card) + 0.5rem);
  }
  .custom-art {
    display: grid;
    place-items: center;
    width: clamp(9rem, 6rem + 8vw, 15rem);
    aspect-ratio: 1;
    border-radius: var(--r-card);
    background: var(--g-lilac);
  }
  .custom-art :global(.plan-illo) {
    width: 62%;
  }
  .custom-body .plan-name {
    margin-top: 0.75rem;
  }
  .custom-body .lead {
    margin-top: 0.75rem;
    max-width: 36ch;
  }

  @media (max-width: 1100px) {
    .plans {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  @media (max-width: 720px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
    }
    .custom {
      grid-template-columns: minmax(0, 1fr);
      padding: 0.75rem 0.75rem 1.75rem;
    }
    .custom-art {
      width: 100%;
      aspect-ratio: 16 / 10;
    }
    .custom-body,
    .custom-btn {
      margin-inline: 0.75rem;
    }
  }
</style>
