---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';

/** Legal texts live in src/content/legal/<doc>.html — edit them there. */
const texts = import.meta.glob<string>('../../content/legal/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const docs = {
  terms_of_service: {
    title: 'Terms of Service',
    heading: 'Terms of Service for Attachment Hippo',
    updated: 'December 18, 2024',
    description: 'Terms of Service for Attachment Hippo - Read our terms and conditions for using the service.',
  },
  privacy_policy: {
    title: 'Privacy Policy',
    heading: 'Privacy Policy',
    updated: 'October 18, 2026',
    description: 'Privacy Policy for Attachment Hippo - Learn how we collect, use, and protect your data.',
  },
  refund_policy: {
    title: 'Refund Policy',
    heading: 'Refund Policy',
    updated: 'December 19, 2024',
    description: 'Refund Policy for Attachment Hippo - Learn about our refund process and cancellation terms.',
  },
} as const;

type Doc = keyof typeof docs;

export function getStaticPaths() {
  return (['terms_of_service', 'privacy_policy', 'refund_policy'] as const).map((doc) => ({ params: { doc } }));
}

const doc = Astro.params.doc as Doc;
const meta = docs[doc];
const html = texts[`../../content/legal/${doc}.html`];
---

<Base title={`${meta.title} — Attachment Hippo`} description={meta.description}>
  <article>
    <header class="sheet sheet--butter sheet--tight">
      <div class="wrap">
        <p class="mono muted">Legal</p>
        <h1 class="legal-title">{meta.heading}</h1>
        <p class="mono updated">Last updated: {meta.updated}</p>
      </div>
    </header>

    <div class="sheet">
      <div class="wrap legal-body">
        <nav class="legal-nav" aria-label="Legal documents">
          <p class="mono muted">Documents</p>
          <ul role="list">
            {
              site.legal.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.href.endsWith(`${doc}.html`) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="legal-content" set:html={html} />
      </div>
    </div>
  </article>
</Base>

<style>
  .legal-title {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.5rem + 5vw, 7rem);
    font-weight: 500;
    line-height: 0.92;
    max-width: 16ch;
    text-wrap: balance;
  }
  .updated {
    margin-top: 1.5rem;
  }
  .legal-body {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 7fr);
    gap: 2rem var(--gutter);
  }
  .legal-nav {
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .legal-nav ul {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }
  .legal-nav a {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    font-size: var(--fs-s);
    font-weight: 600;
    text-decoration: none;
  }
  .legal-nav a:hover {
    background: var(--grey);
  }
  .legal-nav a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }

  /* --- the imported legal markup --- */
  .legal-content {
    min-width: 0;
    max-width: 46rem;
  }
  .legal-content :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.375rem);
    font-weight: 500;
    line-height: 1.05;
    margin: 3rem 0 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .legal-content > :global(h2:first-child),
  .legal-content > :global(:first-child > h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .legal-content :global(h3) {
    font-size: var(--fs-m);
    font-weight: 800;
    margin: 2rem 0 0.5rem;
  }
  .legal-content :global(p),
  .legal-content :global(li) {
    line-height: 1.7;
    color: var(--ink-2);
  }
  .legal-content :global(p) {
    margin-bottom: 1rem;
  }
  .legal-content :global(ul),
  .legal-content :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }
  .legal-content :global(li) {
    margin-bottom: 0.375rem;
  }
  .legal-content :global(strong) {
    color: var(--ink);
  }
  .legal-content :global(a) {
    text-decoration-color: var(--primary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
  }
  .legal-content :global(.highlight-box),
  .legal-content :global(.important-notice),
  .legal-content :global(.disclaimer) {
    margin: 1.5rem 0;
    padding: 1.5rem;
    border-radius: var(--r-card);
    background: var(--grey);
  }
  .legal-content :global(.important-notice),
  .legal-content :global(.disclaimer) {
    background: #ffe9dc;
  }
  .legal-content :global(.highlight-box p:last-child),
  .legal-content :global(.important-notice p:last-child),
  .legal-content :global(.disclaimer p:last-child) {
    margin-bottom: 0;
  }
  .legal-content :global(.contact-info),
  .legal-content :global(.contact-section) {
    margin-top: 3rem;
  }

  @media (max-width: 900px) {
    .legal-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .legal-nav {
      position: static;
    }
  }
</style>
