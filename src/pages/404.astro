---
import Base from '../layouts/Base.astro';
import Illo from '../components/Illo.astro';
---

<Base title="Page not found — Attachment Hippo" description="This page could not be found." noindex>
  <section class="sheet sheet--lilac nf">
    <div class="wrap nf-grid">
      <div>
        <p class="mono muted">Error 404</p>
        <h1 class="nf-code">Lost?</h1>
        <p class="lead">This page has wandered off. The hippo looked everywhere.</p>
        <a class="btn btn--ink btn--lg" href="/">Back to the home page <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <Illo name="part-funnel" class="nf-illo" />
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 70vh;
    display: grid;
    align-items: center;
  }
  .nf-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }
  .nf-code {
    font-family: var(--font-display);
    font-size: clamp(6rem, 2rem + 16vw, 16rem);
    font-weight: 500;
    line-height: 0.85;
    margin: 0.75rem 0 1.5rem;
  }
  .lead {
    max-width: 30ch;
    margin-bottom: 2rem;
  }
  .nf-grid :global(.nf-illo) {
    width: 100%;
    max-width: 18rem;
    justify-self: center;
  }
  @media (max-width: 700px) {
    .nf-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .nf-grid :global(.nf-illo) {
      max-width: 10rem;
      justify-self: start;
    }
  }
</style>
