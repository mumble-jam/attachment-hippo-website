---
import Base from '../../layouts/Base.astro';
import AuraIcon from '../../components/AuraIcon.astro';
import { getPosts, getBody, readingTime, formatDate, isoDate } from '../../lib/blog';
import { site } from '../../site.config';

const posts = await getPosts();
const description =
  'Practical guides on Gmail automation, saving attachments to Google Drive, and reducing inbox busywork — from the team behind Attachment Hippo.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Gmail Automation Blog',
  url: new URL('/blog/', site.url).href,
  description,
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, site.url).href,
    datePublished: isoDate(p.data.pubDate),
  })),
};
---

<Base
  title="Blog — Attachment Hippo"
  description={description}
  keywords="Gmail automation, Google Drive, save email attachments, Gmail productivity, attachment rules"
  jsonLd={jsonLd}
>
  <section class="sheet sheet--sky sheet--tight intro" aria-labelledby="blog-title">
    <div class="wrap intro-grid">
      <div>
        <p class="mono muted">Gmail Automation Blog</p>
        <h1 id="blog-title" class="h2 intro-title">Blog</h1>
      </div>
      <div class="intro-side">
        <AuraIcon name="part-envelope" class="intro-illo" />
        <p class="lead">Tips, guides, and insights on Gmail™ automation, productivity, and making the most of your attachments</p>
      </div>
    </div>
  </section>

  <section class="sheet" aria-label="Articles">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">Articles</h2>
        <span class="side">{String(posts.length).padStart(2, '0')}</span>
      </div>

      <ol class="posts" role="list">
        {
          posts.map((post, i) => {
            const minutes = readingTime(getBody(post.id));
            return (
              <li class="post" data-reveal>
                <a class="post-link" href={`/blog/${post.id}/`}>
                  <div class="post-image">
                    <img
                      src={post.data.cover}
                      alt=""
                      width="1000"
                      height="525"
                      loading={i < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </div>
                  <div class="meta-row mono">
                    <span>{post.data.tags.join(' · ')}</span>
                    <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
                  </div>
                  <h3 class="h3 post-title">{post.data.title}</h3>
                </a>
                <p class="excerpt">{post.data.excerpt ?? post.data.description}</p>
                <p class="mono muted post-extra">
                  {minutes} min read{post.data.series && ` · ${post.data.series}`}
                </p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem var(--gutter);
    align-items: end;
  }
  .intro-title {
    font-size: clamp(5rem, 2rem + 12vw, 13rem);
    line-height: 0.85;
    margin-top: 0.75rem;
  }
  .intro-side {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
  }
  .intro-side :global(.intro-illo) {
    width: clamp(5rem, 3rem + 5vw, 8rem);
    flex: none;
  }
  .intro-side .lead {
    max-width: 28ch;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 2rem + 3vw, 5rem) var(--gutter);
  }
  .post:nth-child(even) {
    margin-top: clamp(0rem, -2rem + 10vw, 8rem);
  }
  .post-link {
    display: block;
    text-decoration: none;
  }
  .post-image {
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--grey);
    aspect-ratio: 1000 / 600;
    margin-bottom: 1.25rem;
  }
  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease);
  }
  .post-link:hover .post-image img {
    transform: scale(1.04);
  }
  .post-title {
    margin-top: 0.875rem;
    max-width: 22ch;
  }
  .post-link:hover .post-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }
  .excerpt {
    margin-top: 0.875rem;
    max-width: 46ch;
    color: var(--ink-2);
  }
  .post-extra {
    margin-top: 0.75rem;
  }

  @media (max-width: 760px) {
    .intro-grid,
    .posts {
      grid-template-columns: minmax(0, 1fr);
    }
    .post:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
