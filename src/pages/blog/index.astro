---
import Base from '../../layouts/Base.astro';
import { getPosts, getBody, readingTime, formatDate, isoDate } from '../../lib/blog';
import { site } from '../../site.config';

const posts = await getPosts();
const description =
  'Practical guides on Gmail automation, saving attachments to Google Drive, and reducing inbox busywork — from the team behind Attachment Hippo.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Gmail Automation Blog',
  url: new URL('/blog/', site.url).href,
  description,
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, site.url).href,
    datePublished: isoDate(p.data.pubDate),
  })),
};
---

<Base
  title="Blog — Attachment Hippo"
  description={description}
  keywords="Gmail automation, Google Drive, save email attachments, Gmail productivity, attachment rules"
  jsonLd={jsonLd}
>
  <section class="wrap blog" aria-labelledby="blog-title">
    <div class="grid page-head">
      <span class="label"><span class="accent">Blog</span></span>
      <h1 id="blog-title" class="display">Gmail Automation Blog</h1>
      <p class="lead intro">
        Tips, guides, and insights on Gmail™ automation, productivity, and making the most of your attachments
      </p>
    </div>

    <ol class="posts" role="list">
      {
        posts.map((post, i) => {
          const minutes = readingTime(getBody(post.id));
          return (
            <li class="grid post-row">
              <div class="post-meta-col">
                <span class="num index">{String(posts.length - i).padStart(2, '0')}</span>
                <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
                <span class="muted">{minutes} min read</span>
                {post.data.series && <span class="muted">{post.data.series}</span>}
              </div>
              <div class="post-text">
                <h2 class="h3 post-title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="excerpt">{post.data.excerpt ?? post.data.description}</p>
                <ul class="tags" role="list">
                  {post.data.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
              <a class="post-image" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
                <img
                  src={post.data.cover}
                  alt=""
                  width="1000"
                  height="525"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>
</Base>

<style>
  .blog {
    padding-block: clamp(2.5rem, 1rem + 5vw, 6rem) var(--section);
  }
  .accent {
    color: var(--accent);
  }
  .page-head {
    row-gap: var(--s-2);
    margin-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .page-head .label,
  .page-head h1 {
    grid-column: 1 / -1;
  }
  .page-head h1 {
    max-width: 12ch;
  }
  .intro {
    grid-column: 7 / -1;
    margin-top: var(--s-4);
    max-width: 34ch;
  }

  .posts {
    border-bottom: 1px solid var(--ink);
  }
  .post-row {
    position: relative;
    border-top: var(--rule-ink);
    padding-block: var(--s-3) var(--s-6);
    row-gap: var(--s-3);
  }
  .post-row + .post-row {
    border-top: 1px solid var(--ink);
  }
  .post-meta-col {
    grid-column: 1 / span 3;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--fs-s);
  }
  .index {
    font-size: var(--fs-s);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: var(--s-1);
  }
  .post-text {
    grid-column: 4 / span 5;
  }
  .post-title a {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 300ms var(--ease);
  }
  /* whole row is clickable */
  .post-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post-row:hover .post-title a {
    background-size: 100% 2px;
  }
  .excerpt {
    margin-top: var(--s-2);
    font-size: var(--fs-body);
    color: var(--ink-2);
    max-width: 52ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: var(--s-3);
  }
  .tags li {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--rule);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--ink-3);
  }
  .post-image {
    grid-column: 9 / -1;
    overflow: hidden;
    background: var(--mist);
    aspect-ratio: 1000 / 525;
  }
  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease);
  }
  .post-row:hover .post-image img {
    transform: scale(1.03);
  }

  @media (max-width: 960px) {
    .intro {
      grid-column: 1 / -1;
    }
    .post-meta-col {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
    }
    .index {
      margin-bottom: 0;
    }
    .post-text {
      grid-column: 1 / span 7;
    }
    .post-image {
      grid-column: 8 / -1;
    }
  }
  @media (max-width: 640px) {
    .post-text,
    .post-image {
      grid-column: 1 / -1;
    }
    .post-image {
      grid-row: 2;
    }
  }
</style>
