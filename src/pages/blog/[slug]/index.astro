---
import Base from '../../../layouts/Base.astro';
import { getPosts, getBody, readingTime, formatDate, isoDate, type Post } from '../../../lib/blog';
import { site } from '../../../site.config';
import '../../../styles/article.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { data } = post;
const body = getBody(post.id);
const minutes = readingTime(body);
const url = new URL(`/blog/${post.id}/`, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  image: new URL(data.cover, site.url).href,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: data.author },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  mainEntityOfPage: url,
  keywords: data.keywords,
};
---

<Base
  title={data.seoTitle ?? data.title}
  description={data.description}
  keywords={data.keywords}
  image={data.cover}
  imageAlt={data.coverAlt}
  type="article"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={data.pubDate.toISOString()} />
    {data.updatedDate && <meta property="article:modified_time" content={data.updatedDate.toISOString()} />}
    {data.tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>

  <article class="post">
    <header class="sheet sheet--mint sheet--tight post-header">
      <div class="wrap">
        <a class="back mono" href="/blog/"><span aria-hidden="true">←</span> All articles</a>
        {data.eyebrow && <p class="post-eyebrow mono">{data.eyebrow}</p>}
        <h1 class="post-title">{data.title}</h1>
        <dl class="post-meta">
          <div class="post-meta-item">
            <dt>Published</dt>
            <dd><time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time></dd>
          </div>
          <div class="post-meta-item">
            <dt>Author</dt>
            <dd>{data.author}</dd>
          </div>
          <div class="post-meta-item">
            <dt>Reading time</dt>
            <dd>{minutes} min</dd>
          </div>
          {
            data.series && (
              <div class="post-meta-item">
                <dt>Series</dt>
                <dd>{data.series}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    <div class="sheet post-sheet">
      <div class="wrap">
        <figure class="post-featured-image">
          <img src={data.cover} alt={data.coverAlt} width="1731" height="909" fetchpriority="high" />
        </figure>

        <div class="post-body">
          <aside class="post-aside" aria-label="About this article">
            {
              data.tags.length > 0 && (
                <div>
                  <p class="mono muted">Topics</p>
                  <ul class="post-tags" role="list">
                    {data.tags.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
              )
            }
            <a class="btn aside-cta" href={site.installUrl} target="_blank" rel="noopener noreferrer">
              {site.installLabel}
            </a>
          </aside>

          <div class="post-content" set:html={body} />
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  .post-sheet {
    padding-top: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--gutter);
  }
  .post-aside {
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 3rem;
  }
  .post-tags {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .post-tags li {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--grey);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .aside-cta {
    align-self: flex-start;
    white-space: normal;
    text-align: left;
  }
  @media (max-width: 960px) {
    .post-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-aside {
      display: none;
    }
  }
</style>
