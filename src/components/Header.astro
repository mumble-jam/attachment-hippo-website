---
import Logo from './Logo.astro';
import { site } from '../site.config';

const path = Astro.url.pathname.replace(/index\.html$/, '');
const isCurrent = (href: string) =>
  !href.includes('#') && (path === href || (href !== '/' && path.startsWith(href.replace(/\.html$/, ''))));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.name} — home`}>
      <Logo width={40} />
      <span>Attachment Hippo</span>
    </a>

    <nav class="primary" aria-label="Main">
      <ul role="list">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn cta" href={site.installUrl} target="_blank" rel="noopener noreferrer">Add to Gmail™</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="menu-label">Menu</span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Main" hidden>
    <div class="wrap">
      <ul role="list">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--lg btn--block" href={site.installUrl} target="_blank" rel="noopener noreferrer">
        {site.installLabel}
      </a>
    </div>
  </nav>
</header>

<p class="announce">
  <span>Free plan — save up to 10 attachments a month.</span>
  <a href="/pricing.html">See plans</a>
</p>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.getElementById('mobile-nav');
  const label = toggle?.querySelector('.menu-label');

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    document.documentElement.classList.toggle('nav-open', open);
    if (label) label.textContent = open ? 'Close' : 'Menu';
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-radius: 0 0 var(--r-sheet) var(--r-sheet);
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    font-weight: 700;
    font-size: var(--fs-s);
    letter-spacing: -0.01em;
  }
  .primary ul {
    display: flex;
    justify-content: space-around;
  }
  .primary a {
    position: relative;
    font-size: var(--fs-s);
    font-weight: 600;
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    transition: background-color 200ms var(--ease);
  }
  .primary a:hover {
    background: var(--grey);
  }
  .primary a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }
  .cta {
    min-height: 2.5rem;
    padding-block: 0.5rem;
  }
  .menu-toggle {
    display: none;
    padding: 0.5rem 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--grey);
    font-size: var(--fs-s);
    font-weight: 600;
    cursor: pointer;
  }
  .mobile-nav {
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding-bottom: 2rem;
  }
  .mobile-nav li {
    border-top: 1px solid var(--line);
  }
  .mobile-nav li a {
    display: block;
    padding-block: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 4vw, 4rem);
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }
  .mobile-nav ul {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .announce {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    padding: 0.75rem var(--margin);
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.8125rem;
    text-align: center;
  }
  .announce a {
    color: var(--paper);
    font-weight: 700;
    text-decoration: none;
  }
  .announce a:hover {
    color: var(--peach);
  }

  @media (max-width: 899px) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    .primary,
    .cta {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
  :global(html.nav-open) {
    overflow: hidden;
  }
</style>
