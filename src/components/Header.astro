---
import Logo from './Logo.astro';
import { site } from '../site.config';

const path = Astro.url.pathname.replace(/index\.html$/, '');
const isCurrent = (href: string) =>
  !href.includes('#') && (path === href || (href !== '/' && path.startsWith(href.replace(/\.html$/, ''))));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.name} — home`}>
      <Logo width={46} />
      <span class="brand-name">Attachment<br />Hippo</span>
    </a>

    <nav class="primary" aria-label="Main">
      <ul role="list">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--ink btn--sm cta" href={site.installUrl} target="_blank" rel="noopener noreferrer">
      {site.installLabel}
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="menu-label">Menu</span>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Main" hidden>
    <div class="wrap">
      <ul role="list">
        {
          site.nav.map((item, i) => (
            <li>
              <a href={item.href}>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--ink btn--block" href={site.installUrl} target="_blank" rel="noopener noreferrer">
        {site.installLabel}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.getElementById('mobile-nav');
  const label = toggle?.querySelector('.menu-label');

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    document.documentElement.classList.toggle('nav-open', open);
    if (label) label.textContent = open ? 'Close' : 'Menu';
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  window.matchMedia('(min-width: 961px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }
  .bar {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: center;
    height: var(--header-h);
  }
  .brand {
    grid-column: 1 / span 3;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    width: max-content;
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .primary {
    grid-column: 4 / span 6;
  }
  .primary ul {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2.25rem);
  }
  .primary a {
    position: relative;
    font-size: var(--fs-s);
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.25rem;
  }
  .primary a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease);
  }
  .primary a:hover::after,
  .primary a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .cta {
    grid-column: 10 / -1;
    justify-self: end;
  }
  .menu-toggle {
    display: none;
  }

  .mobile-nav {
    border-top: var(--rule-hair);
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    background: var(--paper);
  }
  .mobile-nav ul {
    margin-bottom: var(--s-4);
  }
  .mobile-nav li {
    border-bottom: var(--rule-hair);
  }
  .mobile-nav li a {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-block: var(--s-2);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-decoration: none;
  }
  .mobile-nav .num {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0;
  }

  @media (max-width: 960px) {
    .primary,
    .cta {
      display: none;
    }
    .brand {
      grid-column: 1 / span 8;
    }
    .menu-toggle {
      grid-column: 9 / -1;
      justify-self: end;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0;
      background: none;
      border: 0;
      cursor: pointer;
      font-size: var(--fs-s);
      font-weight: 600;
    }
    .menu-icon {
      position: relative;
      width: 1.375rem;
      height: 0.75rem;
    }
    .menu-icon span {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--ink);
      transition: transform 200ms var(--ease), top 200ms var(--ease);
    }
    .menu-icon span:first-child {
      top: 0;
    }
    .menu-icon span:last-child {
      top: calc(100% - 2px);
    }
    .menu-toggle[aria-expanded='true'] .menu-icon span {
      top: calc(50% - 1px);
    }
    .menu-toggle[aria-expanded='true'] .menu-icon span:first-child {
      transform: rotate(45deg);
    }
    .menu-toggle[aria-expanded='true'] .menu-icon span:last-child {
      transform: rotate(-45deg);
    }
  }
  :global(html.nav-open) {
    overflow: hidden;
  }
</style>
