---
import Logo from './Logo.astro';
import CopyEmail from './CopyEmail.astro';
import { site } from '../site.config';

const year = new Date().getFullYear();
const years = year > site.startYear ? `${site.startYear}–${year}` : `${site.startYear}`;
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="word" aria-hidden="true">
      <Logo width={120} class="word-mark" />
      <span>Hippo</span>
    </div>

    <div class="side">
      <div class="mail"><CopyEmail email={site.email} max="3.5rem" /></div>

      <div class="cols">
        <nav aria-label="Site">
          <ul role="list">
            <li><a href="/">Home</a></li>
            {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
        <nav aria-label="Legal">
          <ul role="list">
            {site.legal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            <li>
              <a href={site.installUrl} target="_blank" rel="noopener noreferrer">Google Workspace Marketplace ↗</a>
            </li>
          </ul>
        </nav>
      </div>

      <div class="base">
        <p class="copyright" data-start-year={site.startYear}>All rights reserved {years}</p>
        <p>Gmail™ and Google Drive™ are trademarks of Google LLC.</p>
      </div>
    </div>
  </div>
</footer>

<script>
  // Keep the copyright range current between deploys.
  document.querySelectorAll<HTMLElement>('[data-start-year]').forEach((el) => {
    const start = Number(el.dataset.startYear);
    const now = new Date().getFullYear();
    el.textContent = `All rights reserved ${now > start ? `${start}–${now}` : start}`;
  });
</script>

<style>
  .site-footer {
    margin-top: 0.5rem;
    background: var(--paper);
    border-radius: var(--r-sheet) var(--r-sheet) 0 0;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem var(--gutter);
    align-items: start;
  }
  .word {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(6rem, 1rem + 17vw, 17rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.02em;
    user-select: none;
  }
  .word :global(.word-mark) {
    width: 0.62em;
    height: auto;
    color: var(--primary);
    margin-bottom: 0.06em;
  }
  .mail {
    width: 100%;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    margin-top: 2.5rem;
  }
  .cols ul {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }
  .cols a {
    display: inline-block;
    padding-block: 0.25rem;
    font-size: var(--fs-s);
    font-weight: 600;
    text-decoration: none;
  }
  .cols a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .base {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  @media (max-width: 899px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
