---
import Logo from './Logo.astro';
import { site } from '../site.config';

const year = new Date().getFullYear();
const years = year > site.startYear ? `${site.startYear}–${year}` : `${site.startYear}`;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="grid cols">
      <div class="col brand">
        <Logo width={72} class="footer-mark" />
        <p class="tagline">Save Gmail™ attachments to Drive™ automatically.</p>
      </div>

      <nav class="col" aria-label="Site">
        <span class="label label--muted">Site</span>
        <ul role="list">
          {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <nav class="col" aria-label="Legal">
        <span class="label label--muted">Legal</span>
        <ul role="list">
          {site.legal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="col">
        <span class="label label--muted">Contact</span>
        <ul role="list">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a href={site.installUrl} target="_blank" rel="noopener noreferrer">Google Workspace Marketplace ↗</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="baseline">
      <p class="copyright" data-start-year={site.startYear}>All rights reserved {years}</p>
      <p class="muted">Gmail™ and Google Drive™ are trademarks of Google LLC.</p>
    </div>

    <p class="wordmark" aria-hidden="true">Attachment Hippo</p>
  </div>
</footer>

<script>
  // Keep the copyright range current between deploys (same as the old copyright.js).
  document.querySelectorAll<HTMLElement>('[data-start-year]').forEach((el) => {
    const start = Number(el.dataset.startYear);
    const now = new Date().getFullYear();
    el.textContent = `All rights reserved ${now > start ? `${start}–${now}` : start}`;
  });
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--ink);
    padding-top: var(--s-8);
    overflow: hidden;
  }
  .cols {
    row-gap: var(--s-6);
  }
  .col {
    grid-column: span 3;
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .tagline {
    font-family: var(--font-display);
    font-size: var(--fs-l);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    max-width: 16ch;
  }
  .col .label {
    padding-bottom: var(--s-1);
    margin-bottom: var(--s-1);
    border-bottom: var(--rule-hair);
  }
  .col li a {
    display: inline-block;
    padding-block: 0.3rem;
    font-size: var(--fs-s);
    text-decoration: none;
  }
  .col li a:hover {
    color: var(--accent);
  }
  .baseline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-1) var(--s-4);
    margin-top: var(--s-8);
    padding-block: var(--s-2);
    border-top: var(--rule-hair);
    font-size: var(--fs-xs);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    /* sized so the line spans the content width exactly (text is ~7.53em wide) */
    font-size: calc((min(100vw, var(--max)) - 2 * var(--margin)) / 7.7);
    line-height: 0.8;
    letter-spacing: -0.055em;
    white-space: nowrap;
    margin-left: -0.04em;
    margin-bottom: -0.06em;
    user-select: none;
  }
  @media (max-width: 960px) {
    .col {
      grid-column: span 6;
    }
  }
  @media (max-width: 520px) {
    .col {
      grid-column: 1 / -1;
    }
  }
</style>
