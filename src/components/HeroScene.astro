---
/**
 * Animated hero: glowing attachments leave the Gmail envelope, arc over the
 * hippo and land in the Drive folder. Envelope, hippo and folder are aura
 * illustrations; the flying files are SVG (<animateMotion> along the route).
 */
import AuraIcon from './AuraIcon.astro';
import AuraHippo from './AuraHippo.astro';

const W = 1200;
const H = 440;
const pct = (v: number, of: number) => `${(v / of) * 100}%`;

const files = [
  { id: 'peach', a: 'var(--a-peach-top)', b: 'var(--a-peach-core)', begin: '0s' },
  { id: 'mint', a: 'var(--a-mint-top)', b: 'var(--a-mint-core)', begin: '1.5s' },
  { id: 'sky', a: 'var(--a-sky-top)', b: 'var(--a-sky-core)', begin: '3s' },
];
// The route the files travel along (also drawn as the dotted line).
const route = { p0: [150, 220], p1: [360, -10], p2: [840, -10], p3: [1050, 232] } as const;
const routeD = `M${route.p0}C${route.p1} ${route.p2} ${route.p3}`;
/** point on the route at t (0…1) — cubic Bézier */
const at = (t: number) => {
  const u = 1 - t;
  const c = (i: 0 | 1) => u ** 3 * route.p0[i] + 3 * u ** 2 * t * route.p1[i] + 3 * u * t ** 2 * route.p2[i] + t ** 3 * route.p3[i];
  return { x: +c(0).toFixed(1), y: +c(1).toFixed(1) };
};
// glows sit exactly on the line
const glows = [
  { ...at(0.2), r: 14, d: '0s' },
  { ...at(0.52), r: 10, d: '-1s' },
  { ...at(0.8), r: 12, d: '-2s' },
];
---

<figure class="scene" aria-label="Attachments travel from Gmail to a Google Drive folder automatically">
  <div class="scene-stage" style={`aspect-ratio:${W}/${H}`}>
    <!-- back: ground, route, glows -->
    <svg class="scene-svg" viewBox={`0 0 ${W} ${H}`} fill="none" aria-hidden="true">
      <defs>
        <radialGradient id="glow">
          <stop offset="0" style="stop-color:var(--a-butter-top)"></stop>
          <stop offset=".45" style="stop-color:var(--primary);stop-opacity:.9"></stop>
          <stop offset="1" style="stop-color:var(--primary);stop-opacity:0"></stop>
        </radialGradient>
        <radialGradient id="shade">
          <stop offset="0" stop-color="#28185a" stop-opacity=".22"></stop>
          <stop offset="1" stop-color="#28185a" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <ellipse cx="150" cy="414" rx="118" ry="11" fill="url(#shade)"></ellipse>
      <ellipse class="scene-hippo-shade" cx="600" cy="420" rx="170" ry="12" fill="url(#shade)"></ellipse>
      <ellipse cx="1050" cy="414" rx="118" ry="11" fill="url(#shade)"></ellipse>
      <path id="route" d={routeD} stroke="#0b0b0b" stroke-width="2.5" stroke-dasharray="2 12" stroke-linecap="round" opacity=".3"></path>
      {glows.map((g) => <circle class="scene-glow" style={`animation-delay:${g.d}`} cx={g.x} cy={g.y} r={g.r * 2.2} fill="url(#glow)" />)}
    </svg>

    <div class="scene-item scene-envelope" style={`left:${pct(30, W)};top:${pct(176, H)};width:${pct(240, W)}`}>
      <AuraIcon name="part-envelope" />
    </div>
    <div class="scene-item scene-hippo" style={`left:${pct(410, W)};top:${pct(200, H)};width:${pct(380, W)}`}>
      <AuraHippo />
    </div>
    <div class="scene-item scene-folder" style={`left:${pct(930, W)};top:${pct(176, H)};width:${pct(240, W)}`}>
      <AuraIcon name="part-folder" />
    </div>

    <!-- front: flying attachments -->
    <svg class="scene-svg scene-front" viewBox={`0 0 ${W} ${H}`} fill="none" aria-hidden="true">
      <defs>
        {
          files.map((f) => (
            <radialGradient id={`file-${f.id}`} cx=".35" cy=".25" r=".95">
              <stop offset="0" style={`stop-color:${f.a}`} />
              <stop offset="1" style={`stop-color:${f.b}`} />
            </radialGradient>
          ))
        }
        <filter id="soft" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="1.4"></feGaussianBlur></filter>
      </defs>
      {
        files.map((f) => (
          <g class="scene-file" opacity="0">
            <g class="scene-file-body" filter="url(#soft)">
              <path d="M-24 -32H10C12 -32 13 -31.5 14.5 -30L27 -17.5C28.5 -16 29 -15 29 -13V28C29 32 27 34 23 34H-24C-28 34 -30 32 -30 28V-26C-30 -30 -28 -32 -24 -32Z" fill={`url(#file-${f.id})`} />
              <path d="M-18 -4H16M-18 8H10M-18 20H14" stroke="#fff" stroke-opacity=".7" stroke-width="5" stroke-linecap="round" />
            </g>
            <animateMotion dur="4.5s" begin={f.begin} repeatCount="indefinite" calcMode="spline" keyTimes="0;1" keyPoints="0;1" keySplines="0.45 0 0.55 1">
              <mpath href="#route" />
            </animateMotion>
            <animate attributeName="opacity" dur="4.5s" begin={f.begin} repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.1;0.88;1" />
          </g>
        ))
      }
    </svg>
  </div>

  <figcaption class="scene-labels">
    <span><span class="mono">Gmail™</span><span class="muted">Your inbox</span></span>
    <span><span class="mono">Drive™</span><span class="muted">Your folder</span></span>
  </figcaption>
</figure>

<style>
  .scene {
    position: relative;
  }
  .scene-stage {
    position: relative;
    width: 100%;
  }
  .scene-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .scene-front {
    z-index: 2;
  }
  .scene-item {
    position: absolute;
    z-index: 1;
  }
  .scene-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
    padding-inline: 2.5%;
  }
  .scene-labels > span {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-size: var(--fs-s);
  }
  .scene-labels > span:last-child {
    text-align: right;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scene-hippo {
      transform-origin: 50% 100%;
      animation: hippo-walk 0.75s ease-in-out infinite alternate;
    }
    .scene-file-body {
      animation: file-spin 2.25s ease-in-out infinite;
    }
    .scene-hippo-shade {
      transform-box: fill-box;
      transform-origin: center;
      animation: shade-breathe 0.75s ease-in-out infinite alternate;
    }
    .scene-glow {
      transform-box: fill-box;
      transform-origin: center;
      animation: twinkle 3s ease-in-out infinite;
    }
    /* the envelope lets go of a file and the folder catches one every 1.5s */
    .scene-envelope :global([data-part~='letter']),
    .scene-envelope :global([data-part~='paperclip']) {
      animation: env-peek 1.5s ease-in-out infinite !important;
    }
    .scene-folder :global([data-part~='folder-front']) {
      transform-origin: 50% var(--b);
      animation: folder-catch 1.5s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene-file {
      display: none;
    }
  }

  @keyframes hippo-walk {
    from {
      transform: translateY(0) rotate(-0.8deg);
    }
    to {
      transform: translateY(-2.5%) rotate(1deg);
    }
  }
  /* same start and end, so files never snap mid-flight */
  @keyframes file-spin {
    0%,
    100% {
      transform: rotate(-10deg) scale(0.88);
    }
    50% {
      transform: rotate(8deg) scale(1.08);
    }
  }
  @keyframes shade-breathe {
    from {
      transform: scaleX(1);
      opacity: 1;
    }
    to {
      transform: scaleX(0.9);
      opacity: 0.7;
    }
  }
  @keyframes twinkle {
    0%,
    100% {
      transform: scale(0.7);
      opacity: 0.55;
    }
    50% {
      transform: scale(1.15);
      opacity: 1;
    }
  }
  /* starts and ends at rest, so the loop never snaps */
  @keyframes env-peek {
    0%,
    100% {
      transform: translateY(0);
    }
    24% {
      transform: translateY(-3.5%);
    }
    62% {
      transform: translateY(0);
    }
  }
  @keyframes folder-catch {
    0%,
    100% {
      transform: scale(1, 1);
    }
    10% {
      transform: scale(1.03, 0.94);
    }
    24% {
      transform: scale(0.99, 1.015);
    }
    40% {
      transform: scale(1, 1);
    }
  }
</style>
